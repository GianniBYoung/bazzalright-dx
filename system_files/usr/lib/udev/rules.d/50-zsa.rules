# ZSA keyboards (ErgoDox EZ, Moonlander, Planck EZ, Voyager)
# Grants the active seat user access for Keymapp, Oryx (WebHID) and flashing.
# Adapted from ZSA's upstream rules: plugdev/0666 replaced with uaccess.

# Raw HID: Oryx live training, Keymapp, firmware version queries
KERNEL=="hidraw*", ATTRS{idVendor}=="3297", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="16c0", TAG+="uaccess"

# Legacy WebUSB live training (firmware < v21)
SUBSYSTEM=="usb", ATTR{idVendor}=="3297", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="feed", ATTR{idProduct}=="1307", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="feed", ATTR{idProduct}=="6060", TAG+="uaccess"

# ErgoDox EZ bootloader (Teensy HalfKay)
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789B]?", ENV{ID_MM_DEVICE_IGNORE}="1"
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789A]?", ENV{MTP_NO_PROBE}="1"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789ABCD]?", TAG+="uaccess"
KERNEL=="ttyACM*", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789B]?", TAG+="uaccess"

# Moonlander / Planck EZ bootloader (STM32 DFU)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", TAG+="uaccess", SYMLINK+="stm32_dfu"
